# ============================================================
# Amazon Scraper - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --------------------------
# MongoDB
# --------------------------
# Full MongoDB connection URI, e.g.:
#   mongodb://localhost:27017
#   mongodb+srv://user:password@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DB=test

# --------------------------
# Proxy Settings
# --------------------------
PROXY_USER=your_proxy_username
PROXY_PASSWORD=your_proxy_password
PROXY_ENDPOINT=your_proxy_host_or_ip
PROXY_PORT=your_proxy_port

# --------------------------
# Remote Server (for download_products.sh)
# --------------------------
REMOTE_HOST=root@your.server.ip
REMOTE_PATH=/home/data/
LOCAL_DESTINATION=./downloads/
